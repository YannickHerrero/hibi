{
  "name": "hibi",
  "private": true,
  "version": "0.0.0",
  "description": "Hibi monorepo — API, portal, docs, and design system for the Hibi SRS ecosystem.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=hibi-client && changeset publish"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
