# ============================================================================
# Hibi monorepo — environment variable template
# ----------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local` per app) and fill in real values.
# Real `.env` files are gitignored. Never commit secrets.
# ============================================================================

# ----- Database (Supabase Postgres, used by @hibi/db and apps/api) -----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hibi

# ----- Supabase (used by apps/api for OTP auth + apps/portal for sessions) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- API (apps/api) --------------------------------------------------------
# Where the portal lives, for CORS allow-list.
PORTAL_URL=http://localhost:5173
# Pepper used when hashing API keys at rest. Generate with `openssl rand -hex 32`.
API_KEY_PEPPER=

# ----- Portal (apps/portal, Vite — must be VITE_ prefixed to be exposed) -----
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
